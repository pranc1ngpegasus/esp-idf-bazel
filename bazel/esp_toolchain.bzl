"""Forwards the ESP toolchain paths the firmware action needs.

Nothing here supplies a compiler: whether nix, espup or a container provides
the toolchain, it exports the four variables below and this rule copies them
into a generated `.bzl`. The firmware action then gets `IDF_PATH`, the ROM ELF
directory, `LIBCLANG_PATH` for bindgen, and the `PATH` holding rustc, cargo,
riscv32-esp-elf-gcc, ldproxy, cmake, ninja and the ESP-IDF Python.
"""

_VARS = {
    "ESP_TOOLCHAIN_PATH": "PATH",
    "ESP_TOOLCHAIN_IDF": "IDF_PATH",
    "ESP_TOOLCHAIN_ROM_ELFS": "ESP_ROM_ELF_DIR",
    "ESP_TOOLCHAIN_LIBCLANG": "LIBCLANG_PATH",
}

def _esp_toolchain_impl(rctx):
    missing = [k for k in _VARS if not rctx.getenv(k)]
    if missing:
        fail("{} is unset; run bazel from `nix develop`, or set them as .github/workflows/ci.yml does".format(", ".join(missing)))

    body = ['"""Generated by @esp_toolchain. Do not edit."""', "", "PATHS = {"]
    for var, name in _VARS.items():
        body.append('    "%s": %s,' % (name, repr(rctx.getenv(var))))
    body.append("}")
    rctx.file("toolpaths.bzl", "\n".join(body) + "\n")
    rctx.file("BUILD.bazel", 'exports_files(["toolpaths.bzl"])\n')

esp_toolchain = repository_rule(
    implementation = _esp_toolchain_impl,
    environ = _VARS.keys(),
    doc = "Forwards the ESP toolchain paths exported by the build environment.",
)
